# flight-rank — all keys OPTIONAL. Copy to .env and fill what you have.
# Without any keys: scrape + static files + bookable deep links still work.
cp .env.example .env   # then uncomment what you have

# Live award seats (seats.aero Pro ~$9.99/mo). Absent → free_links (AA/Southwest/Delta/PointsYeah) + ask-block, never an error.
# SEATS_AERO_API_KEY=

# SerpAPI Google Flights fallback (250 free/mo). Absent → scraper only; price_signal returns a skip message.
# SERPAPI_KEY=

# Duffel GDS cash anchor. Absent → scrape price labeled as source, no traceback.
# DUFFEL_API_KEY_LIVE=

# Delta cookie-replay: path to a file holding your copied delta.com rm-offer-gql curl (cookies expire ~30 min).
# Absent → skip message + ask-block. Needs: pip install curl-cffi (soft dep, NOT in requirements.txt).
# DELTA_CURL_FILE=/tmp/delta-curl.txt

# Self-host SearXNG for live transfer-bonus reads. Absent → localhost:8080 tried, then Jina keyless, then static file.
# SEARXNG_URL=http://localhost:8080
